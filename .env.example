# Copy this file to .env and fill in your actual values

EMAIL=your.email@example.com
PASSWORD=your_password_here

# Country code - can be found in the URL when trying to reschedule
COUNTRY_CODE=gb

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - found from the html select tag of the page source
FACILITY_ID=44

# Polling interval range in seconds - the bot waits a random amount of time in this
# range between checks, to avoid a robotic fixed-interval pattern. Defaults to 20-60s.
MIN_REFRESH_DELAY=20
MAX_REFRESH_DELAY=60

# Legacy fixed delay in seconds (optional). Only used as a fallback if MIN_REFRESH_DELAY
# and MAX_REFRESH_DELAY are both unset. Setting this alone disables randomized jitter.
# REFRESH_DELAY=3

# Current booked appointment date (required) - passed as the bot's -c flag
CURRENT_DATE=2026-06-15

# Target date to stop at (optional) - passed as the bot's -t flag. Leave blank for no target.
TARGET_DATE=

# Minimum acceptable date (optional) - passed as the bot's -m flag. Leave blank for no minimum.
MIN_DATE=

# Set to --dry-run to only log what would be booked without actually booking. Leave blank for real runs.
DRY_RUN_FLAG=

# Comma-separated list of dates (YYYY-MM-DD) to never book, even if otherwise eligible. Optional.
# BLACKLIST_DATES=2026-09-01,2026-09-05

# --- VPN (required by docker-compose.yml's vpn service, using Surfshark via gluetun) ---
# Routes all bot traffic through a WireGuard VPN.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Optional: restrict which Surfshark server location gluetun connects to (comma-separated).
# Leave blank to let gluetun pick automatically. Examples: "United Kingdom", Netherlands
# SERVER_COUNTRIES=
