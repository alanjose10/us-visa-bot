# US Visa Bot Configuration
# Copy this file to .env and fill in your actual values

# Your credentials for https://ais.usvisa-info.com/
EMAIL=your.email@example.com
PASSWORD=your_password_here

# Country code - can be found in the URL when trying to reschedule
# Examples: 'fr' for France, 'br' for Brazil, 'ca' for Canada
COUNTRY_CODE=ca

# Schedule ID - found in the URL when trying to reschedule manually
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/continue_actions
SCHEDULE_ID=12345678

# Facility ID - found in network calls when selecting a new date or inspecting the selector
# Examples: Paris is 44
# URL format: https://ais.usvisa-info.com/en-{COUNTRY_CODE}/niv/schedule/{SCHEDULE_ID}/appointment/address/{FACILITY_ID}
FACILITY_ID=44

# Polling interval range in seconds - the bot waits a random amount of time in this
# range between checks, to avoid a robotic fixed-interval pattern. Defaults to 20-60s.
MIN_REFRESH_DELAY=20
MAX_REFRESH_DELAY=60

# Legacy fixed delay in seconds (optional). Only used as a fallback if MIN_REFRESH_DELAY
# and MAX_REFRESH_DELAY are both unset. Setting this alone disables randomized jitter.
# REFRESH_DELAY=3